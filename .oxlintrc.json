{
  "extends": ["./node_modules/@mastermunj/oxc-config/.oxlintrc.json"],
  "rules": {
    "unicorn/filename-case": [
      "error",
      {
        "cases": { "camelCase": true, "pascalCase": true, "kebabCase": true, "snakeCase": true },
        "ignore": "^[a-z]{2,3}-[A-Z]{2,3}(-f)?(\\.test)?\\.(ts|js)$"
      }
    ]
  }
}
